+// ===== unwrap_err: the panic of `UnwrapErr` (its `panic_msg` moved to `trusted.rs`)
+
+fn unwrap_err(c: &mut Checker) {
+    for fail_at in [Some(1), None] {
+        let mut a = up::UnwrapErr(Src::new(3, fail_at));
+        let mut b = ann::UnwrapErr(Src::new(3, fail_at));
+        let ra = catch(|| up::Rng::next_u32(&mut a));
+        let rb = catch(|| ann::Rng::next_u32(&mut b));
+        c.eq_result("UnwrapErr::next_u32", ra, rb);
+        let ra = catch(|| up::Rng::next_u64(&mut a));
+        let rb = catch(|| ann::Rng::next_u64(&mut b));
+        c.eq_result("UnwrapErr::next_u64", ra, rb);
+        let (mut da, mut db) = ([0u8; 5], [0u8; 5]);
+        let ra = catch(|| up::Rng::fill_bytes(&mut a, &mut da));
+        let rb = catch(|| ann::Rng::fill_bytes(&mut b, &mut db));
+        c.eq_result("UnwrapErr::fill_bytes", ra.map(|_| da), rb.map(|_| db));
+    }
+}
