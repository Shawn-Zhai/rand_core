+// ===== utils
+
+/// `fill_bytes_via_next_word` with `next_word` failing at call `fail_at` (or never).
+macro_rules! fill_via_next_word_test {
+    ($fname:ident, $w:ty) => {
+        fn $fname(c: &mut Checker) {
+            for len in 0..=41usize {
+                for fail_at in (0..=12).map(Some).chain([None]) {
+                    let run = |f: &dyn Fn(&mut [u8], &mut dyn FnMut() -> Result<$w, usize>) -> Result<(), usize>| {
+                        let mut x = Xs(len as u64 * 31 + 7);
+                        let mut calls = 0usize;
+                        let mut dst = vec![0x5Au8; len];
+                        let r = f(&mut dst, &mut || {
+                            calls += 1;
+                            if Some(calls - 1) == fail_at { Err(calls) } else { Ok(x.next() as $w) }
+                        });
+                        (r, dst, calls)
+                    };
+                    let a = run(&|d, nw| up::utils::fill_bytes_via_next_word(d, nw));
+                    let b = run(&|d, nw| ann::utils::fill_bytes_via_next_word(d, nw));
+                    c.eq("fill_bytes_via_next_word", a, b);
+                }
+            }
+        }
+    };
+}
