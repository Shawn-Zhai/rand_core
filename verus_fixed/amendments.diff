+// ===== seedable_rng: the seed that `seed_from_u64` passes to `from_seed`, for seeds of any length
+
+#[derive(Clone)]
+struct Seed<const L: usize>([u8; L]);
+
+impl<const L: usize> Default for Seed<L> {
+    fn default() -> Self {
+        Seed([0; L])
+    }
+}
+
+impl<const L: usize> AsRef<[u8]> for Seed<L> {
+    fn as_ref(&self) -> &[u8] {
+        &self.0
+    }
+}
+
+impl<const L: usize> AsMut<[u8]> for Seed<L> {
+    fn as_mut(&mut self) -> &mut [u8] {
+        &mut self.0
+    }
+}
+
+struct Recorder<const L: usize>([u8; L]);
+
+impl<const L: usize> up::SeedableRng for Recorder<L> {
+    type Seed = Seed<L>;
+    fn from_seed(seed: Seed<L>) -> Self {
+        Recorder(seed.0)
+    }
+}
+
+impl<const L: usize> ann::SeedableRng for Recorder<L> {
+    type Seed = Seed<L>;
+    fn from_seed(seed: Seed<L>) -> Self {
+        Recorder(seed.0)
+    }
+}
+
+macro_rules! seed_test {
+    ($c:ident, $($l:literal),*) => {$(
+        let mut x = Xs(0x5eed);
+        for i in 0..300u64 {
+            let state = match i { 0 => 0, 1 => 1, 2 => u64::MAX, _ => x.next() };
+            let a = <Recorder<$l> as up::SeedableRng>::seed_from_u64(state).0;
+            let b = <Recorder<$l> as ann::SeedableRng>::seed_from_u64(state).0;
+            $c.eq(concat!("seed_from_u64, seed length ", $l), a, b);
+        }
+    )*};
+}
