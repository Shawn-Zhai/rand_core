+#!/usr/bin/env bash
+# Differential test of the annotated crate (`verus_fixed/`) against upstream (`src/`): see
+# src/main.rs. Cargo cannot build two packages named `rand_core` 0.10.1 together, so this copies
+# upstream's `src/`, `Cargo.toml` and `README.md` to `target/upstream-copy`, renamed
+# `rand_core_upstream`, then runs the test in a debug build (upstream's `debug_assert!`s on) and a
+# release build. Usage (from anywhere): verus_fixed/verification/differential/run.sh
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"
+repo="$(cd "$here/../../.." && pwd)"
+copy="$here/target/upstream-copy"
+rm -rf "$copy"
+mkdir -p "$copy"
+cp -r "$repo/src" "$repo/README.md" "$copy/"
+sed 's/^name = "rand_core"$/name = "rand_core_upstream"/' "$repo/Cargo.toml" > "$copy/Cargo.toml"
+grep -q '^name = "rand_core_upstream"$' "$copy/Cargo.toml"
+cd "$here"
+cargo run -q
+cargo run -q --release
