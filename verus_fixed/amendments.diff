+#[derive(Debug, PartialEq)]
+struct SrcError(u32);
+
+impl fmt::Display for SrcError {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        write!(f, "source failed at call {}", self.0)
+    }
+}
+
+impl core::error::Error for SrcError {}
+
+/// A byte and word source implementing both crates' `TryRng`, failing at call `fail_at`.
+#[derive(Clone, Debug, PartialEq)]
+struct Src {
+    x: u64,
+    calls: u32,
+    fail_at: Option<u32>,
+    fill_lens: Vec<usize>,
+}
+
+impl Src {
+    fn new(seed: u64, fail_at: Option<u32>) -> Src {
+        Src { x: seed | 1, calls: 0, fail_at, fill_lens: vec![] }
+    }
+
+    fn step(&mut self) -> Result<u64, SrcError> {
+        self.calls += 1;
+        if Some(self.calls) == self.fail_at {
+            return Err(SrcError(self.calls));
+        }
+        let mut xs = Xs(self.x);
+        let v = xs.next();
+        self.x = xs.0;
+        Ok(v)
+    }
+
+    fn fill(&mut self, dst: &mut [u8]) -> Result<(), SrcError> {
+        self.fill_lens.push(dst.len());
+        let v = self.step()?;
+        for (i, b) in dst.iter_mut().enumerate() {
+            *b = (v >> (8 * (i % 8))) as u8 ^ i as u8;
+        }
+        Ok(())
+    }
+}
+
+macro_rules! src_try_rng {
+    ($krate:ident) => {
+        impl $krate::TryRng for Src {
+            type Error = SrcError;
+            fn try_next_u32(&mut self) -> Result<u32, SrcError> {
+                self.step().map(|v| v as u32)
+            }
+            fn try_next_u64(&mut self) -> Result<u64, SrcError> {
+                self.step()
+            }
+            fn try_fill_bytes(&mut self, dst: &mut [u8]) -> Result<(), SrcError> {
+                self.fill(dst)
+            }
+        }
+    };
+}
+
+src_try_rng!(up);
+src_try_rng!(ann);
+
+fn via_fill_and_u32(c: &mut Checker) {
+    for seed in 1..=40u64 {
+        for fail_at in [None, Some(1), Some(2), Some(3)] {
+            let (mut a, mut b) = (Src::new(seed, fail_at), Src::new(seed, fail_at));
+            let ra = up::utils::next_word_via_fill::<u32, Src>(&mut a);
+            let rb = ann::utils::next_word_via_fill::<u32, Src>(&mut b);
+            c.eq("next_word_via_fill::<u32>", (ra, a), (rb, b));
+            let (mut a, mut b) = (Src::new(seed, fail_at), Src::new(seed, fail_at));
+            let ra = up::utils::next_word_via_fill::<u64, Src>(&mut a);
+            let rb = ann::utils::next_word_via_fill::<u64, Src>(&mut b);
+            c.eq("next_word_via_fill::<u64>", (ra, a), (rb, b));
+            let (mut a, mut b) = (Src::new(seed, fail_at), Src::new(seed, fail_at));
+            let ra = up::utils::next_u64_via_u32(&mut a);
+            let rb = ann::utils::next_u64_via_u32(&mut b);
+            c.eq("next_u64_via_u32", (ra, a), (rb, b));
+        }
+    }
+}
