+//! Differential test: upstream `rand_core` (`up`, the repository's `src/`) and the annotated crate
+//! (`ann`, `verus_fixed/`) side by side, on every function whose code verification changed. Each
+//! result, every byte written, the state observed after each step and each panic message must be
+//! equal. Run both `cargo run` (upstream's `debug_assert!`s are on) and `cargo run --release`.
+
+use std::cell::Cell;
+use std::fmt;
+use std::panic::{self, AssertUnwindSafe};
+
+thread_local! {
+    /// Set while `catch` runs: the panics there are expected, and compared rather than printed.
+    static QUIET: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Test inputs (xorshift64; not under test).
+#[derive(Clone)]
+struct Xs(u64);
+
+impl Xs {
+    fn next(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x << 13;
+        x ^= x >> 7;
+        x ^= x << 17;
+        self.0 = x;
+        x
+    }
+
+    fn below(&mut self, n: u64) -> u64 {
+        self.next() % n
+    }
+}
+
+/// `f()`, or its panic message.
+fn catch<T>(f: impl FnOnce() -> T) -> Result<T, String> {
+    QUIET.with(|q| q.set(true));
+    let r = panic::catch_unwind(AssertUnwindSafe(f));
+    QUIET.with(|q| q.set(false));
+    r.map_err(|e| {
+        if let Some(s) = e.downcast_ref::<String>() {
+            s.clone()
+        } else if let Some(s) = e.downcast_ref::<&str>() {
+            s.to_string()
+        } else {
+            "<non-string panic>".to_string()
+        }
+    })
+}
+
+#[derive(Default)]
+struct Checker {
+    comparisons: usize,
+    panics: usize,
+}
+
+impl Checker {
+    fn eq<T: PartialEq + fmt::Debug>(&mut self, what: &str, up: T, ann: T) {
+        self.comparisons += 1;
+        if up != ann {
+            eprintln!("DIFFERENCE in {what}:\n  upstream:  {up:?}\n  annotated: {ann:?}");
+            std::process::exit(1);
+        }
+    }
+
+    fn eq_result<T: PartialEq + fmt::Debug>(&mut self, what: &str, up: Result<T, String>, ann: Result<T, String>) {
+        self.panics += up.is_err() as usize;
+        self.eq(what, up, ann);
+    }
+}
+
+// ===== block: one generator type implementing both crates' `Generator`
+
+macro_rules! generator {
+    ($name:ident, $w:ty, $mul:expr) => {
+        #[derive(Clone, Debug, PartialEq)]
+        struct $name<const N: usize> {
+            state: $w,
+        }
+
+        impl<const N: usize> $name<N> {
+            fn block(&mut self) -> [$w; N] {
+                let mut out = [0; N];
+                for w in out.iter_mut() {
+                    self.state = self.state.wrapping_mul($mul).wrapping_add(1);
+                    *w = self.state ^ (self.state >> 7);
+                }
+                out
+            }
+        }
+
+        impl<const N: usize> up::block::Generator for $name<N> {
+            type Output = [$w; N];
+            fn generate(&mut self, output: &mut [$w; N]) {
+                *output = self.block();
+            }
+        }
+
+        impl<const N: usize> ann::block::Generator for $name<N> {
+            type Output = [$w; N];
+            fn generate(&mut self, output: &mut [$w; N]) {
+                *output = self.block();
+            }
+        }
+    };
+}
+
+generator!(Gen32, u32, 0x9E37_79B9);
+generator!(Gen64, u64, 0x9E37_79B9_7F4A_7C15);
+
+/// Random operations on a `BlockRng` of each crate, compared after every step.
+macro_rules! block_test {
+    ($fname:ident, $gen:ident, $w:ty, $u64_from_u32:tt) => {
+        fn $fname<const N: usize>(seed: u64, steps: usize, c: &mut Checker) {
+            let mut x = Xs(seed | 1);
+            let size = std::mem::size_of::<$w>();
+            let mut a = up::block::BlockRng::new($gen::<N> { state: seed as $w });
+            let mut b = ann::block::BlockRng::new($gen::<N> { state: seed as $w });
+            for _ in 0..steps {
+                match x.below(8) {
+                    0 | 1 => c.eq_result("next_word", catch(|| a.next_word()), catch(|| b.next_word())),
+                    2 if $u64_from_u32 => {
+                        // (`next_u64_from_u32` exists for `u32` words only)
+                        let ra = catch(|| block_test!(@u64 a, $u64_from_u32));
+                        let rb = catch(|| block_test!(@u64 b, $u64_from_u32));
+                        let panicked = ra.is_err();
+                        c.eq_result("next_u64_from_u32", ra, rb);
+                        if panicked {
+                            // `N == 1`: it panics after `generate`, leaving a generated word as
+                            // the index (see `corrupted_state`); continue from a well-formed state.
+                            a.reset_and_skip(0);
+                            b.reset_and_skip(0);
+                        }
+                    }
+                    2 | 3 => {
+                        let len = x.below(3 * (N * size) as u64 + 5) as usize;
+                        let (mut da, mut db) = (vec![0xA5u8; len], vec![0xA5u8; len]);
+                        let ra = catch(|| a.fill_bytes(&mut da));
+                        let rb = catch(|| b.fill_bytes(&mut db));
+                        c.eq_result("fill_bytes", ra.map(|_| da), rb.map(|_| db));
+                    }
+                    4 => {
+                        // includes `n >= N`, which panics in both
+                        let n = x.below(N as u64 + 2) as usize;
+                        c.eq_result("reset_and_skip", catch(|| a.reset_and_skip(n)), catch(|| b.reset_and_skip(n)));
+                    }
+                    5 => c.eq("word_offset", a.word_offset(), b.word_offset()),
+                    6 => {
+                        // from `remaining_results` (round trip), or a slice of any length
+                        let rest: Vec<$w> = if x.below(2) == 0 {
+                            a.remaining_results().to_vec()
+                        } else {
+                            (0..x.below(N as u64 + 2)).map(|_| x.next() as $w).collect()
+                        };
+                        let ra = catch(|| up::block::BlockRng::<$gen<N>>::reconstruct(a.core.clone(), &rest));
+                        let rb = catch(|| ann::block::BlockRng::<$gen<N>>::reconstruct(b.core.clone(), &rest));
+                        c.eq("reconstruct is_some", ra.as_ref().map(|r| r.is_some()), rb.as_ref().map(|r| r.is_some()));
+                        if let (Ok(Some(ra)), Ok(Some(rb))) = (ra, rb) {
+                            a = ra;
+                            b = rb;
+                        }
+                    }
+                    _ => {
+                        a = a.clone();
+                        b = b.clone();
+                    }
+                }
+                c.eq("remaining_results", a.remaining_results().to_vec(), b.remaining_results().to_vec());
+                c.eq("core", &a.core, &b.core);
+            }
+        }
+    };
+    (@u64 $r:ident, true) => {
+        $r.next_u64_from_u32()
+    };
+    (@u64 $r:ident, false) => {
+        unreachable!()
+    };
+}
+
+block_test!(block_u32, Gen32, u32, true);
+block_test!(block_u64, Gen64, u64, false);
+
+/// `reconstruct` with `N == 0` (`new` panics there in both crates).
+fn block_empty(c: &mut Checker) {
+    let ra = catch(|| up::block::BlockRng::<Gen32<0>>::reconstruct(Gen32 { state: 1 }, &[]).is_none());
+    let rb = catch(|| ann::block::BlockRng::<Gen32<0>>::reconstruct(Gen32 { state: 1 }, &[]).is_none());
+    c.eq_result("reconstruct, N = 0", ra, rb);
+    let ra = catch(|| up::block::BlockRng::<Gen32<0>>::reconstruct(Gen32 { state: 1 }, &[7]).is_none());
+    let rb = catch(|| ann::block::BlockRng::<Gen32<0>>::reconstruct(Gen32 { state: 1 }, &[7]).is_none());
+    c.eq_result("reconstruct, N = 0, one word", ra, rb);
+    let ra = catch(|| up::block::BlockRng::new(Gen32::<0> { state: 1 }).word_offset());
+    let rb = catch(|| ann::block::BlockRng::new(Gen32::<0> { state: 1 }).word_offset());
+    c.eq_result("new, N = 0", ra, rb);
+}
+
+/// The state that a caught panic between `generate` and `set_index` leaves: the word stored as the
+/// index is a generated word. `next_u64_from_u32` with `N == 1` panics there on every call (as does
+/// a panicking `Generator::generate`). Only two results differ, both only in this state: returns
+/// the descriptions of the differences seen.
+fn corrupted_state(c: &mut Checker) -> Vec<&'static str> {
+    let mut seen = vec![];
+    for seed in 1..=200u64 {
+        let mut a = up::block::BlockRng::new(Gen32::<1> { state: seed as u32 });
+        let mut b = ann::block::BlockRng::new(Gen32::<1> { state: seed as u32 });
+        c.eq_result("next_u64_from_u32, N = 1", catch(|| a.next_u64_from_u32()), catch(|| b.next_u64_from_u32()));
+        c.eq("word_offset, corrupted", a.word_offset(), b.word_offset());
+        c.eq("core, corrupted", &a.core, &b.core);
+        // 1. `remaining_results`: `&results[index..]` vs `&results[index..N]`, an index above `N`
+        let ra = catch(|| a.remaining_results().to_vec());
+        let rb = catch(|| b.remaining_results().to_vec());
+        c.eq("remaining_results panics, corrupted", ra.is_err(), rb.is_err());
+        if ra != rb {
+            let (ma, mb) = (ra.unwrap_err(), rb.unwrap_err());
+            c.eq("remaining_results, corrupted: upstream's message", ma.starts_with("range start index "), true);
+            c.eq("remaining_results, corrupted: annotated message", mb.starts_with("slice index starts at "), true);
+            seen.push("remaining_results: both panic (index > N), with different messages");
+        }
+        // 2. `fill_bytes` of nothing stores the index back: upstream's `debug_assert!` in `set_index`
+        let fa = catch(|| a.fill_bytes(&mut []));
+        let fb = catch(|| b.fill_bytes(&mut []));
+        if fa != fb {
+            c.eq("fill_bytes(&mut []), corrupted: debug build", cfg!(debug_assertions), true);
+            c.eq("fill_bytes(&mut []), corrupted: upstream", fa, Err("assertion failed: 0 < index && index <= N".to_string()));
+            c.eq("fill_bytes(&mut []), corrupted: annotated", fb, Ok(()));
+            seen.push("fill_bytes(&mut []): upstream's debug_assert in set_index fires (debug builds only)");
+        }
+        // both recover: the next word regenerates the block
+        c.eq_result("next_word, corrupted", catch(|| a.next_word()), catch(|| b.next_word()));
+        c.eq("remaining_results, recovered", a.remaining_results().to_vec(), b.remaining_results().to_vec());
+    }
+    seen.sort();
+    seen.dedup();
+    seen
+}
