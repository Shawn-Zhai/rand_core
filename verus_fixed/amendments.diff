+fn main() {
+    let default_hook = panic::take_hook();
+    panic::set_hook(Box::new(move |info| {
+        if !QUIET.with(|q| q.get()) {
+            default_hook(info)
+        }
+    }));
+    let mut c = Checker::default();
+    for seed in 1..=12u64 {
+        block_u32::<1>(seed, 1500, &mut c);
+        block_u32::<2>(seed, 1500, &mut c);
+        block_u32::<3>(seed, 1500, &mut c);
+        block_u32::<4>(seed, 1500, &mut c);
+        block_u32::<16>(seed, 1500, &mut c);
+        block_u64::<1>(seed, 1500, &mut c);
+        block_u64::<5>(seed, 1500, &mut c);
+        block_u64::<8>(seed, 1500, &mut c);
+    }
+    block_empty(&mut c);
+    let corrupted = corrupted_state(&mut c);
+    fill_via_next_word_u32(&mut c);
+    fill_via_next_word_u64(&mut c);
+    via_fill_and_u32(&mut c);
+    read_words_test!(c, u32, 0, 1, 2, 3, 8);
+    read_words_test!(c, u64, 0, 1, 2, 3, 8);
+    seed_test!(c, 0, 1, 2, 3, 4, 5, 7, 8, 9, 12, 16, 31, 32, 33, 40, 64);
+    unwrap_err(&mut c);
+    println!(
+        "{} build: {} comparisons, all equal ({} of them of panics, with equal messages)",
+        if cfg!(debug_assertions) { "debug" } else { "release" },
+        c.comparisons,
+        c.panics,
+    );
+    for d in corrupted {
+        println!("  after a caught panic between `generate` and `set_index` only: {d}");
+    }
+}
